{
  "name": "debate-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI Debate Arena — conference stand activity",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c magenta,cyan \"npm:server\" \"npm:client\"",
    "server": "node server.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/test-degradation.mjs && node tests/test-tournament.mjs && node tests/test-store-server.mjs && node tests/test-fight-integrity.mjs",
    "test:unit": "node tests/test-degradation.mjs && node tests/test-tournament.mjs && node tests/test-store-server.mjs",
    "test:store": "node tests/test-store-server.mjs",
    "test:fight": "node tests/test-fight-integrity.mjs",
    "test:api": "node tests/test-api.mjs",
    "cards": "node scripts/build-cards.mjs",
    "economics": "node scripts/build-economics.mjs",
    "budget": "node scripts/budget-from-log.mjs",
    "start": "concurrently -k -n SERVER,CLIENT -c magenta,cyan \"npm:server\" \"vite preview --port 5173\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.0"
  }
}
