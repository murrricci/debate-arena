# Скопируй в .env и подставь свой ключ.

# Ключ сервиса. LLM_API_KEY — нейтральное имя; OPENROUTER_API_KEY оставлен для совместимости.
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL OpenAI-совместимого сервиса (база до /v1). По умолчанию — OpenRouter.
# Примеры: https://api.openai.com/v1 | https://api.proxyapi.ru/openai/v1 | https://api.together.xyz/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Модели по тирам деградации (необязательно). Каждый тир — список через запятую:
# первая модель основная, остальные — фоллбэки этого тира. Тир 1 — сильнейший (PRIME),
# тир 3 — слабейший (FRIED). Пробуются по порядку; если весь список тира недоступен —
# берётся общий LLM_FALLBACKS.
LLM_TIER_1=openai/gpt-oss-120b:free
LLM_TIER_2=meta-llama/llama-3.3-70b-instruct:free
LLM_TIER_3=openai/gpt-oss-20b:free

# Отдельный тир для СУДЬИ (оценки раундов + финальный вердикт). Не часть лестницы деградации
# бойцов — судья всегда арбитр, ему нужна стабильная модель. Список через запятую (первая
# основная, остальные его фоллбэки). Не задано → как раньше: модели тира 1.
LLM_TIER_JUDGE=

# Лимит токенов ответа судьи. Пусто → берётся из запроса (фронт шлёт 300). Если у судьи включён
# reasoning, лучше поднять (например 800–1500), иначе рассуждение съест лимит и вердикт будет пуст.
LLM_MAX_TOKENS_JUDGE=

# Случайный выбор модели внутри тира. Выкл (по умолчанию) — модели тира пробуются по порядку
# (первая основная, остальные фоллбэки). Вкл (1/true/on) — порядок моделей тира тасуется на
# каждый запрос: «основной» становится случайная модель тира, остальные остаются его фоллбэками
# (пустой ответ/ошибка → другая модель этого тира; весь тир недоступен → общий LLM_FALLBACKS).
LLM_TIER_RANDOM=0

# Общий «последний рубеж» — когда весь список выбранного тира недоступен (через запятую).
# Пусто или не задано → фоллбэков нет (пробуются только модели выбранного тира).
LLM_FALLBACKS=qwen/qwen3-next-80b-a3b-instruct:free,meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-20b:free

# Уровень «рассуждения» reasoning-моделей. У них max_tokens делится между скрытым reasoning и
# ответом — при низком лимите reasoning съедает всё, и ответ приходит пустым. По умолчанию off
# (reasoning выключен — весь лимит идёт на ответ). Значения: low|medium|high — доля бюджета на
# reasoning; none/off — выключить reasoning вовсе; пусто — не слать параметр (хосты без поддержки).
LLM_REASONING_EFFORT=off

# Уровень reasoning отдельно для СУДЬИ. Те же значения (low|medium|high|none/off|пусто). Не задано
# → наследует LLM_REASONING_EFFORT. Хочешь, чтобы судья «думал», а бойцы нет: LLM_REASONING_EFFORT=off,
# а здесь low|medium (и подними LLM_MAX_TOKENS_JUDGE, чтобы рассуждение не съело лимит).
LLM_REASONING_EFFORT_JUDGE=

# Legacy: основная модель тира 1, если LLM_TIER_1 не задан. Порт бэкенда.
LLM_MODEL=openai/gpt-oss-120b:free
PORT=3001

# Логи. LLM_LOG=0 — выключить тайминг-логи в консоли. LLM_LOG_FILE — путь к JSONL-логу
# обращений (модель + точные токены вход/выход на вызов) для расчёта бюджета; относительный
# путь считается от папки server.js. По умолчанию logs/llm-usage.jsonl; "0" — не писать файл.
LLM_LOG=1
LLM_LOG_FILE=logs/llm-usage.jsonl
