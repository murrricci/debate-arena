# Скопируй в .env и подставь свой ключ.

# Ключ сервиса. LLM_API_KEY — нейтральное имя; OPENROUTER_API_KEY оставлен для совместимости.
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL OpenAI-совместимого сервиса (база до /v1). По умолчанию — OpenRouter.
# Примеры: https://api.openai.com/v1 | https://api.proxyapi.ru/openai/v1 | https://api.together.xyz/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Модели по тирам деградации (необязательно). Каждый тир — список через запятую:
# первая модель основная, остальные — фоллбэки этого тира. Тир 1 — сильнейший (PRIME),
# тир 3 — слабейший (FRIED). Пробуются по порядку; если весь список тира недоступен —
# берётся общий LLM_FALLBACKS.
LLM_TIER_1=openai/gpt-oss-120b:free
LLM_TIER_2=meta-llama/llama-3.3-70b-instruct:free
LLM_TIER_3=openai/gpt-oss-20b:free

# Общий «последний рубеж» — когда весь список выбранного тира недоступен (через запятую).
LLM_FALLBACKS=qwen/qwen3-next-80b-a3b-instruct:free,meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-20b:free

# Legacy: основная модель тира 1, если LLM_TIER_1 не задан. Порт бэкенда.
LLM_MODEL=openai/gpt-oss-120b:free
PORT=3001
